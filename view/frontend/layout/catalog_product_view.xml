<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The beacon counts one view of the product page; it prints nothing where Most Viewed is off -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Catalog\Block\Product\View"
                   name="hryvinskyi.catalog.sorting.most.viewed.beacon"
                   template="Hryvinskyi_CatalogSortingMostViewed::product/view-beacon.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Hryvinskyi\CatalogSortingMostViewed\ViewModel\ProductViewBeacon</argument>
                    <argument name="asset_renderer" xsi:type="object">Hryvinskyi\ThemeAssets\Api\AssetRendererInterface</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
