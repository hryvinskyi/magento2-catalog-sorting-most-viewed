declare(strict_types=1);

use Hryvinskyi\CatalogSortingMostViewed\ViewModel\ProductViewBeacon;
use Hryvinskyi\ThemeAssets\Api\AssetRendererInterface;

/**
 * The product page's view beacon: a hidden element holding the endpoint URL and the product id, and the deferred
 * script that sends them once. The page is full-page cached, so the element holds nothing about the visitor.
 * Prints nothing where Most Viewed is not enabled in the store or the page shows no saved product.
 *
 * Block arguments: view_model (the beacon view model) and asset_renderer.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */

$viewBeacon = $block->getData('view_model');
$assetRenderer = $block->getData('asset_renderer');
if (!$viewBeacon instanceof ProductViewBeacon || !$assetRenderer instanceof AssetRendererInterface) {
    return;
}

$beacon = $viewBeacon->getBeacon($block->getProduct());
if ($beacon === null) {
    return;
}
?>
<div data-hryvinskyi-view-beacon
     data-url="<?= $escaper->escapeHtmlAttr($beacon['url']) ?>"
     data-product="<?= $escaper->escapeHtmlAttr((string)$beacon['product']) ?>"
     hidden></div>
<?= /* @noEscape */ $assetRenderer->renderScript(
    'Hryvinskyi_CatalogSortingMostViewed::js/product-view-beacon.js',
    AssetRendererInterface::RENDER_EXTERNAL,
    AssetRendererInterface::LOAD_DEFER,
    AssetRendererInterface::PRELOAD_DISABLED
) ?>
