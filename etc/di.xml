<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Hryvinskyi\CatalogSortingMostViewed\Api\MostViewedConfigInterface"
                type="Hryvinskyi\CatalogSortingMostViewed\Model\MostViewedConfig"/>
    <preference for="Hryvinskyi\CatalogSortingMostViewed\Api\ProductViewCounterInterface"
                type="Hryvinskyi\CatalogSortingMostViewed\Model\ResourceModel\ProductViewCounter"/>
    <preference for="Hryvinskyi\CatalogSortingMostViewed\Api\ProductViewPrunerInterface"
                type="Hryvinskyi\CatalogSortingMostViewed\Model\ResourceModel\ProductViewPruner"/>

    <!--
        All three registrations are global: the refresh runs from cron and the command line, the document fields
        at index time, the sort field on every search request, and the listing option in every area that lists
        sort orders.
    -->
    <virtualType name="HryvinskyiCatalogSortingMostViewedMetric"
                 type="Hryvinskyi\CatalogSortingMetrics\Model\ConfiguredMetric">
        <arguments>
            <argument name="source" xsi:type="object">Hryvinskyi\CatalogSortingMostViewed\Model\ResourceModel\MostViewedMetricSource</argument>
            <argument name="code" xsi:type="string">most_viewed</argument>
            <argument name="documentField" xsi:type="string">sort_most_viewed</argument>
            <argument name="fieldType" xsi:type="string">long</argument>
            <argument name="enabledPath" xsi:type="string">catalog_sorting/most_viewed/enabled</argument>
        </arguments>
    </virtualType>
    <type name="Hryvinskyi\CatalogSortingMetrics\Model\MetricRegistry">
        <arguments>
            <argument name="metrics" xsi:type="array">
                <item name="most_viewed" xsi:type="object">HryvinskyiCatalogSortingMostViewedMetric</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="HryvinskyiCatalogSortingMostViewedSortField"
                 type="Hryvinskyi\CatalogSorting\Model\ConfiguredShopperSortField">
        <arguments>
            <argument name="code" xsi:type="string">most_viewed</argument>
            <argument name="field" xsi:type="string">sort_most_viewed</argument>
            <argument name="fieldType" xsi:type="string">long</argument>
            <argument name="missingValue" xsi:type="number">0</argument>
        </arguments>
    </virtualType>
    <type name="Hryvinskyi\CatalogSorting\Model\Search\ShopperSortFields">
        <arguments>
            <argument name="sortFields" xsi:type="array">
                <item name="most_viewed" xsi:type="object">HryvinskyiCatalogSortingMostViewedSortField</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="HryvinskyiCatalogSortingMostViewedListingOption"
                 type="Hryvinskyi\CatalogSortingOptions\Model\ConfigFlagListingSortOption">
        <arguments>
            <argument name="code" xsi:type="string">most_viewed</argument>
            <argument name="label" xsi:type="string" translate="true">Most Viewed</argument>
            <argument name="enabledPath" xsi:type="string">catalog_sorting/most_viewed/enabled</argument>
            <argument name="defaultDirection" xsi:type="string">desc</argument>
        </arguments>
    </virtualType>
    <type name="Hryvinskyi\CatalogSortingOptions\Model\ListingSortOptions">
        <arguments>
            <argument name="options" xsi:type="array">
                <item name="most_viewed" xsi:type="object" sortOrder="110">HryvinskyiCatalogSortingMostViewedListingOption</item>
            </argument>
        </arguments>
    </type>
</config>
